generator client {
  provider = "prisma-client-js"
}

// banco no Neon. DIRECT_URL e a url sem "-pooler", usada pelo prisma db push
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id       Int         @id @default(autoincrement())
  nome     String
  email    String      @unique
  senha    String
  cidade   String?
  bio      String?
  criadoEm DateTime    @default(now())
  skills   UserSkill[]

  curtidasDadas     Curtida[] @relation("CurtidasDadas")
  curtidasRecebidas Curtida[] @relation("CurtidasRecebidas")

  encontrosCriados    Encontro[]  @relation("EncontrosCriados")
  encontrosRecebidos  Encontro[]  @relation("EncontrosRecebidos")
  avaliacoesDadas     Avaliacao[] @relation("AvaliacoesDadas")
  avaliacoesRecebidas Avaliacao[] @relation("AvaliacoesRecebidas")
  mensagensEnviadas   Mensagem[]  @relation("MensagensEnviadas")
  mensagensRecebidas  Mensagem[]  @relation("MensagensRecebidas")
}

model Skill {
  id       Int         @id @default(autoincrement())
  nome     String      @unique
  usuarios UserSkill[]
}

// tipo: "ensina" ou "aprende"
model UserSkill {
  id      Int    @id @default(autoincrement())
  tipo    String
  userId  Int
  skillId Int
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id])

  @@unique([userId, skillId, tipo])
}

// gostou = true e curtir, gostou = false e passar
model Curtida {
  id       Int      @id @default(autoincrement())
  deId     Int
  paraId   Int
  gostou   Boolean
  criadoEm DateTime @default(now())
  de       User     @relation("CurtidasDadas", fields: [deId], references: [id], onDelete: Cascade)
  para     User     @relation("CurtidasRecebidas", fields: [paraId], references: [id], onDelete: Cascade)

  @@unique([deId, paraId])
}

// status: "proposto", "aceito" ou "realizado"
model Encontro {
  id          Int         @id @default(autoincrement())
  criadorId   Int
  convidadoId Int
  local       String
  dataHora    DateTime
  status      String      @default("proposto")
  codigo      String
  criadoEm    DateTime    @default(now())
  criador     User        @relation("EncontrosCriados", fields: [criadorId], references: [id], onDelete: Cascade)
  avaliacoes  Avaliacao[]
  convidado   User        @relation("EncontrosRecebidos", fields: [convidadoId], references: [id], onDelete: Cascade)
}

model Avaliacao {
  id         Int      @id @default(autoincrement())
  encontroId Int
  deId       Int
  paraId     Int
  nota       Int
  comentario String?
  criadoEm   DateTime @default(now())
  encontro   Encontro @relation(fields: [encontroId], references: [id], onDelete: Cascade)
  de         User     @relation("AvaliacoesDadas", fields: [deId], references: [id], onDelete: Cascade)
  para       User     @relation("AvaliacoesRecebidas", fields: [paraId], references: [id], onDelete: Cascade)

  @@unique([encontroId, deId])
}

model Mensagem {
  id       Int      @id @default(autoincrement())
  deId     Int
  paraId   Int
  texto    String
  criadoEm DateTime @default(now())
  de       User     @relation("MensagensEnviadas", fields: [deId], references: [id], onDelete: Cascade)
  para     User     @relation("MensagensRecebidas", fields: [paraId], references: [id], onDelete: Cascade)
}
