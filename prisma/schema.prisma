generator client {
  provider = "prisma-client-js"
}

// em producao trocar para "postgresql" (Neon)
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id       Int         @id @default(autoincrement())
  nome     String
  email    String      @unique
  senha    String
  cidade   String?
  bio      String?
  criadoEm DateTime    @default(now())
  skills   UserSkill[]

  curtidasDadas     Curtida[] @relation("CurtidasDadas")
  curtidasRecebidas Curtida[] @relation("CurtidasRecebidas")
}

model Skill {
  id       Int         @id @default(autoincrement())
  nome     String      @unique
  usuarios UserSkill[]
}

// tipo: "ensina" ou "aprende"
model UserSkill {
  id      Int    @id @default(autoincrement())
  tipo    String
  userId  Int
  skillId Int
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id])

  @@unique([userId, skillId, tipo])
}

// gostou = true e curtir, gostou = false e passar
model Curtida {
  id       Int      @id @default(autoincrement())
  deId     Int
  paraId   Int
  gostou   Boolean
  criadoEm DateTime @default(now())
  de       User     @relation("CurtidasDadas", fields: [deId], references: [id], onDelete: Cascade)
  para     User     @relation("CurtidasRecebidas", fields: [paraId], references: [id], onDelete: Cascade)

  @@unique([deId, paraId])
}
